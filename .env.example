# Server network binding (strictly localhost by default)
HOST=127.0.0.1
PORT=4310
NODE_ENV=development
LOG_LEVEL=info

# Plug & Play Local Brain Store (auto-initialized from starter-brain.json)
LOCAL_BRAIN_PATH=./data/local-brain.json
STARTER_BRAIN_PATH=./data/starter-brain.json

# Optional External AI Memory Connectors (set true to mount .amem / .mem0 / .ecc)
ENABLE_EXTERNAL_STORES=false
# AMEM_CLI_PATH=amem
# AMEM_FILE_PATH=~/.agentic-brain.amem
# MEM0_HOME=~/.mem0
# MEM0_USER_ID=default
# MEM0_COLLECTION=antigravity_memories
# ECC_HOME=~/.ecc

# SRE Resilience & Caching Parameters
CACHE_TTL_MS=15000
RATE_LIMIT_MAX_REQUESTS=180
RATE_LIMIT_WINDOW_MS=60000
STORE_TIMEOUT_MS=8000
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_MS=15000
